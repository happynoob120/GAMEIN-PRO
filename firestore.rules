rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (request.auth != null && request.auth.token.email == 'ekagrkhannaind120@gmail.com') ||
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // System configurations & live broadcasts
    match /system/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Tournaments collection (Real-time persistent storage)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Users collection (Identity, profiles, and admin moderation)
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Unique Gamer Handles registry
    match /handles/{handle} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 1v1 Rivalries & head-to-head duels
    match /rivalries/{rivalryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Real-time Participant Match Comms
    match /messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Daily Quests
    match /quests/{questDocId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Admin authorization registry
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
